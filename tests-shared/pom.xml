<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.flowingcode.vaadin</groupId>
        <artifactId>json-migration-helper-parent</artifactId>
        <version>0.9.4-SNAPSHOT</version>
    </parent>

    <artifactId>json-migration-helper-tests</artifactId>
    <packaging>pom</packaging>
    <name>Json Migration Helper :: Shared Tests</name>
    <description>
        Holds the single, shared copy of the test sources (src/test/java) and the common test
        configuration. The tests-v* modules inherit from this module and add these sources via
        build-helper, each running them against a different Vaadin runtime.
    </description>

    <properties>
        <!-- Test modules are never published. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- The library under test, compiled against Vaadin 14. -->
        <dependency>
            <groupId>com.flowingcode.vaadin</groupId>
            <artifactId>json-migration-helper</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Vaadin runtime: version is set per module (tests-v14/23/24/25). -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Optional dependencies of the library are not transitive; declare what the tests need. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest-library</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Add the shared test sources (physically living in this module) as a test-source root
              of each inheriting tests-v* module. ${project.basedir} resolves to the child module,
              so ../tests-shared points back here.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-shared-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/../tests-shared/src/test/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              Default test selection (inherited by tests-v14/v23/v24): the legacy/elemental
              (*Test24) suites plus the always-on common suites. The tests-v25 module overrides
              this to run the Jackson (*Test25) suites instead, plus JsonMigrationHelper25Test:
              that suite exercises the Jackson-backed helper, which is only the active
              implementation on Vaadin 25 (and Jackson 3 requires Java 17+ anyway, while the
              v14/v23 modules must be runnable on their Java 8/11 baselines).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test24.java</include>
                        <include>**/LitRendererMigrationExtensionTest.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
